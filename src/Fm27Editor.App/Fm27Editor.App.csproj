<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType Condition="'$(OS)' == 'Windows_NT'">WinExe</OutputType>
    <OutputType Condition="'$(OS)' != 'Windows_NT'">Exe</OutputType>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- The release workflow passes the tag as -p:Version; a local build stays 0.0.0 and never asks GitHub for updates. -->
    <Version>0.0.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <AssemblyName>Fm27Editor</AssemblyName>
    <Product>FM27 Live</Product>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LocalFontDirectory Condition="'$(LocalFontDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\re\local-fonts</LocalFontDirectory>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="$(LocalFontDirectory)\CabinetGrotesk-Regular.otf" Link="Assets\Fonts\Cabinet\CabinetGrotesk-Regular.otf" />
    <AvaloniaResource Include="$(LocalFontDirectory)\CabinetGrotesk-Medium.otf" Link="Assets\Fonts\Cabinet\CabinetGrotesk-Medium.otf" />
    <AvaloniaResource Include="$(LocalFontDirectory)\CabinetGrotesk-Bold.otf" Link="Assets\Fonts\Cabinet\CabinetGrotesk-Bold.otf" />
    <EmbeddedResource Include="$(LocalFontDirectory)\Cabinet-FFL.txt" LogicalName="FM27Live.Licenses.CabinetGrotesk" />
    <Compile Remove="Localization\Loc.Table*.cs" />
    <EmbeddedResource Include="Localization\tr.json" LogicalName="FM27Live.Turkish" />
    <EmbeddedResource Include="Live\update-public.pem" LogicalName="FM27Live.UpdatePublicKey" />
  </ItemGroup>

  <Target Name="ValidateLocalFonts" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(LocalFontDirectory)\CabinetGrotesk-Regular.otf') Or !Exists('$(LocalFontDirectory)\CabinetGrotesk-Medium.otf') Or !Exists('$(LocalFontDirectory)\CabinetGrotesk-Bold.otf') Or !Exists('$(LocalFontDirectory)\Cabinet-FFL.txt')" Text="Obtain Cabinet Grotesk and its license locally as documented in README-LIVE.md. Fonts are not redistributed in the source repository." />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Fm27Editor.App.Tests" />
    <PackageReference Include="Avalonia" Version="11.3.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.10" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.10" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.10" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Linux-only dependency of Avalonia; pinned past 0.21.2 for GHSA-xrw6-gwf8-vvr9. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fm27Editor.Core\Fm27Editor.Core.csproj" />
    <ProjectReference Include="..\Fm27Editor.UnityMetadata\Fm27Editor.UnityMetadata.csproj" />
  </ItemGroup>

  <!-- The app is Windows x64 only: leave the macOS, Linux and ARM native libraries out of the publish folder. -->
  <Target Name="DropForeignRuntimes" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ForeignRuntime Include="@(ResolvedFileToPublish)" Condition="$([System.String]::new('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/')) And !($([System.String]::new('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/win-x64/')) And ($([MSBuild]::IsOSPlatform('Windows')) Or $([System.String]::new('$(RuntimeIdentifier)').StartsWith('win-x64')))) And !($([System.String]::new('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/osx-arm64/')) And ($([MSBuild]::IsOSPlatform('OSX')) Or $([System.String]::new('$(RuntimeIdentifier)').StartsWith('osx'))))" />
      <ResolvedFileToPublish Remove="@(ForeignRuntime)" />
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <TrimmerRootAssembly Include="Avalonia.Controls.DataGrid" />
    <RdXmlFile Include="rd.xml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\offsets\*.json" Link="offsets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\offsets\layouts\*.json" Link="offsets\layouts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\offsets\fixtures\*.json" Link="offsets\fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Community Football Manager role/duty weights, embedded in the exe so no extra file is installed next to it. -->
    <EmbeddedResource Include="Ratings\rolesAndDuties.json" LogicalName="Fm27Editor.Ratings.rolesAndDuties.json" />
  </ItemGroup>

</Project>
